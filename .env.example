NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_PATH=registro.db
DATABASE_BACKUP_PATH=registro_dos.db
REQUEST_HASH_SECRET=

# SMTP sender for email verification and password recovery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Require encrypted STARTTLS on port 587.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set these once to create the initial superadministrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_USERNAME=
